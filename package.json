{
  "name": "owovo-blog",
  "version": "1.0.0",
  "description": "Personal blog powered by Hugo",
  "scripts": {
    "dev": "hugo server -D",
    "build:site": "hugo --gc --minify",
    "build:search": "pagefind --site public",
    "build": "npm run build:site && npm run build:search",
    "hugo:env": "hugo env",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "hugo",
    "blog"
  ],
  "author": "LIGT",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "> 0.5% in CN",
    "last 2 versions",
    "not dead"
  ],
  "prettier": {
    "plugins": [
      "prettier-plugin-go-template"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "cssnano": "^8.0.2",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.3",
    "prettier-plugin-go-template": "^0.0.15",
    "sass-embedded": "^1.100.0"
  }
}
