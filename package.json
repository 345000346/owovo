{
  "name": "owovo-blog",
  "version": "1.0.0",
  "description": "Personal blog powered by Hugo",
  "scripts": {
    "dev": "hugo server -D",
    "build:site": "hugo --minify",
    "build:search": "pagefind --site public",
    "build": "npm run build:site && npm run build:search",
    "verify:hugo158": "pwsh -NoLogo -NoProfile -File ./scripts/check-hugo-deprecations.ps1",
    "format": "prettier --write \"./**/*.{html,css,js,json,md,yaml,yml}\""
  },
  "keywords": [
    "hugo",
    "blog",
    "tailwind"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "pagefind": "1.4.0",
    "postcss": "^8.4.38",
    "prettier": "^3.6.2",
    "prettier-plugin-go-template": "^0.0.15",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.3"
  }
}
