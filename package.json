{
  "name": "owovo-blog",
  "version": "1.0.0",
  "description": "Personal blog powered by Hugo",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss assets/css/main.css -o static/css/style.css",
    "build:js": "terser assets/js/main.js -o static/js/main.min.js --compress --mangle",
    "dev": "concurrently \"npm:dev:css\" \"npm:dev:js\"",
    "dev:css": "postcss assets/css/main.css -o static/css/style.css --watch",
    "dev:js": "terser assets/js/main.js -o static/js/main.min.js --watch",
    "format": "prettier --write \"./**/*.{html,css,js,json,md}\""
  },
  "keywords": [
    "hugo",
    "blog",
    "tailwind"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-go-template": "^0.0.15",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.3",
    "terser": "^5.43.1"
  }
}
