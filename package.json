{
  "name": "owovo-blog",
  "version": "1.0.0",
  "description": "Personal blog powered by Hugo",
  "scripts": {
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "dev": "npm run sync:fonts && hugo server -D",
    "build:site": "npm run sync:fonts && hugo --gc --minify --cleanDestinationDir",
    "build:search": "pagefind --site public",
    "build": "npm run build:site && npm run build:search",
    "preview": "npm run build:site && npm run build:search -- --serve",
    "hugo:env": "hugo env",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "hugo",
    "blog"
  ],
  "author": "LIGT",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "npm@11.17.0",
  "devDependencies": {
    "@fontsource-variable/noto-serif-sc": "5.2.10",
    "@fontsource/source-code-pro": "5.2.7",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.5",
    "sass-embedded": "^1.100.0"
  }
}
