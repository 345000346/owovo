# EditorConfig - 统一不同编辑器的代码风格
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Hugo 模板与现有 layouts 一致，使用 4 空格
[layouts/**]
indent_size = 4

[Makefile]
indent_style = tab
