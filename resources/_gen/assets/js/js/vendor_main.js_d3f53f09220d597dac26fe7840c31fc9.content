/* Optimized JavaScript for Blog */
(function($) {
  'use strict';

  const Blog = {
    // Cached elements
    $body: $('body'),
    $menuToggle: $('.menu-toggle'),
    $mobileMenu: $('#mobile-menu'),
    $themeSwitch: $('.theme-switch'),

    // Initialize
    init() {
      this.prettify();
      this.changeTitle();
      this.toggleTheme();
      this.toggleMobileMenu();
    },

    // Prettify code blocks
    prettify() {
      $('pre')
        .addClass('prettyprint linenums')
        .attr('style', 'overflow:auto;');
      window.prettyPrint && prettyPrint();
    },

    // Handle external links
    externalUrl() {
      $.expr[':'].external = function(obj) {
        return !obj.href.match(/^mailto\:/) && 
               (obj.hostname !== location.hostname);
      };
      $('a:external')
        .addClass('external')
        .attr('target', '_blank');
    },

    // Change title when window loses focus
    changeTitle() {
      const currentTitle = document.title;
      window.onblur = () => document.title = 'I miss you!（＞﹏＜）';
      window.onfocus = () => document.title = currentTitle;
    },

    // Toggle dark/light theme
    toggleTheme() {
      const currentTheme = window.localStorage && 
                          window.localStorage.getItem('theme');
      const isDark = currentTheme === 'dark';
      
      this.$body.toggleClass('dark-theme', isDark);
      
      this.$themeSwitch.on('click', () => {
        this.$body.toggleClass('dark-theme');
        window.localStorage && 
          window.localStorage.setItem(
            'theme', 
            this.$body.hasClass('dark-theme') ? 'dark' : 'light'
          );
      });
    },

    // Toggle mobile menu
    toggleMobileMenu() {
      this.$menuToggle.on('click', () => {
        this.$menuToggle.toggleClass('active');
        this.$mobileMenu.toggleClass('active');
      });
    }
  };

  // Initialize Blog when document is ready
  $(document).ready(() => Blog.init());

})(jQuery);